#: htdocs/luci-static/resources/view/radius-mac/config.js:102
msgid "-- Manual Entry / Do Not Populate --"
msgstr "-- Manuell inmatning / Fyll inte i --"

#: htdocs/luci-static/resources/view/radius-mac/config.js:60
msgid "1-4094, or empty"
msgstr "1-4094, eller tom"

#: htdocs/luci-static/resources/view/radius-mac/config.js:151
msgid "1-4094, or empty for server default"
msgstr "1-4094, eller tom för serverstandard"

#: htdocs/luci-static/resources/view/radius-mac/config.js:35
msgid "Address is required."
msgstr "Adress krävs."

#: htdocs/luci-static/resources/view/radius-mac/config.js:75
msgid "Associated Server"
msgstr "Associerad server"

#: htdocs/luci-static/resources/view/radius-mac/config.js:101
msgid "Click to select a device..."
msgstr "Klicka för att välja en enhet..."

#: htdocs/luci-static/resources/view/radius-mac/config.js:14
msgid ""
"Configure RADIUS MAC authentication servers and client devices. Changes take "
"effect after the radius-mac service is enabled and (re)started."
msgstr "Konfigurera RADIUS MAC-autentiseringsservrar och klientenheter. Ändringar träder i kraft efter att radius-mac-tjänsten har aktiverats och (om)startats."

#: htdocs/luci-static/resources/view/radius-mac/config.js:56
msgid "Default VLAN ID"
msgstr "Standard VLAN-ID"

#: htdocs/luci-static/resources/view/radius-mac/config.js:21
msgid ""
"Define RADIUS server instances. Each server listens for authentication "
"requests."
msgstr "Definiera RADIUS-serverinstanser. Varje server lyssnar efter autentiseringsförfrågningar."

#: htdocs/luci-static/resources/view/radius-mac/config.js:69
msgid ""
"Define client devices by their MAC addresses and assign them to a server and "
"optionally a VLAN."
msgstr "Definiera klientenheter med deras MAC-adresser och tilldela dem till en server och valfritt ett VLAN."

#: htdocs/luci-static/resources/view/radius-mac/config.js:139
msgid "Description"
msgstr "Beskrivning"

#: htdocs/luci-static/resources/view/radius-mac/config.js:143
msgid "Description must be between 1 and 256 characters."
msgstr "Beskrivningen måste vara mellan 1 och 256 tecken."

#: htdocs/luci-static/resources/view/radius-mac/config.js:26
msgid "Enabled"
msgstr "Aktiverad"

#: htdocs/luci-static/resources/view/radius-mac/config.js:31
msgid ""
"IP address the RADIUS server should listen on. Use 0.0.0.0 for all "
"interfaces."
msgstr "IP-adress som RADIUS-servern ska lyssna på. Använd 0.0.0.0 för alla gränssnitt."

#: htdocs/luci-static/resources/view/radius-mac/config.js:30
msgid "Listen Address"
msgstr "Lyssningsadress"

#: htdocs/luci-static/resources/view/radius-mac/config.js:130
msgid "MAC Address"
msgstr "MAC-adress"

#: htdocs/luci-static/resources/view/radius-mac/config.js:133
msgid "MAC address is required."
msgstr "MAC-adress krävs."

#: htdocs/luci-static/resources/view/radius-mac/config.js:140
msgid "Optional: A descriptive name for this client device."
msgstr "Valfritt: Ett beskrivande namn för denna klientenhet."

#: htdocs/luci-static/resources/view/radius-mac/config.js:148
msgid "Optional: Specific VLAN ID for this client. Overrides server default."
msgstr "Valfritt: Specifikt VLAN-ID för denna klient. Åsidosätter serverstandard."

#: htdocs/luci-static/resources/view/radius-mac/config.js:57
msgid ""
"Optional: VLAN ID assigned to clients if no specific VLAN is configured for "
"their MAC address."
msgstr "Valfritt: VLAN-ID som tilldelas klienter om inget specifikt VLAN har konfigurerats för deras MAC-adress."

#: htdocs/luci-static/resources/view/radius-mac/config.js:98
msgid "Populate from DHCP Static Lease"
msgstr "Fyll i från DHCP statisk lease"

#: htdocs/luci-static/resources/view/radius-mac/config.js:38
msgid "Port"
msgstr "Port"

#: htdocs/luci-static/resources/view/radius-mac/config.js:43
msgid "Port is required."
msgstr "Port krävs."

#: htdocs/luci-static/resources/view/radius-mac/config.js:13
#: root/usr/share/luci/menu.d/luci-app-radius-mac.json:3
msgid "RADIUS MAC Authentication"
msgstr "RADIUS MAC-autentisering"

#: htdocs/luci-static/resources/view/radius-mac/config.js:68
msgid "RADIUS Clients (Devices)"
msgstr "RADIUS-klienter (enheter)"

#: htdocs/luci-static/resources/view/radius-mac/config.js:20
msgid "RADIUS Servers"
msgstr "RADIUS-servrar"

#: htdocs/luci-static/resources/view/radius-mac/config.js:50
msgid "Secret is required."
msgstr "Hemlighet krävs."

#: htdocs/luci-static/resources/view/radius-mac/config.js:52
msgid "Secret must be between 1 and 256 characters."
msgstr "Hemligheten måste vara mellan 1 och 256 tecken."

#: htdocs/luci-static/resources/view/radius-mac/config.js:99
msgid ""
"Select a device from DHCP static leases to auto-fill MAC address and "
"description fields."
msgstr "Välj en enhet från DHCP statiska leaser för att automatiskt fylla i MAC-adress och beskrivningsfält."

#: htdocs/luci-static/resources/view/radius-mac/config.js:76
msgid ""
"Select the RADIUS server instance this client device authenticates against."
msgstr "Välj den RADIUS-serverinstans som denna klientenhet autentiserar mot."

#: htdocs/luci-static/resources/view/radius-mac/config.js:79
msgid "Server: %s"
msgstr "Server: %s"

#: htdocs/luci-static/resources/view/radius-mac/config.js:82
msgid "Server association is required."
msgstr "Serverassociation krävs."

#: htdocs/luci-static/resources/view/radius-mac/config.js:46
msgid "Shared Secret"
msgstr "Delad hemlighet"

#: htdocs/luci-static/resources/view/radius-mac/config.js:47
msgid ""
"Shared secret used to authenticate communication with the NAS (e.g., access "
"point)."
msgstr "Delad hemlighet som används för att autentisera kommunikation med NAS (t.ex. åtkomstpunkt)."

#: htdocs/luci-static/resources/view/radius-mac/config.js:39
msgid "UDP port the RADIUS server should listen on."
msgstr "UDP-port som RADIUS-servern ska lyssna på."

#: htdocs/luci-static/resources/view/radius-mac/config.js:91
msgid "Unnamed Host"
msgstr "Namnlös värd"

#: htdocs/luci-static/resources/view/radius-mac/config.js:147
#: htdocs/luci-static/resources/view/radius-mac/config.js:63
msgid "VLAN ID must be a number between 1 and 4094."
msgstr "VLAN-ID måste vara ett tal mellan 1 och 4094."

#: htdocs/luci-static/resources/view/radius-mac/config.js:147
msgid "VLAN ID"
msgstr "VLAN-ID"

